generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id              String   @id @default(uuid())
  bitrix_user_id  String   @unique
  name            String
  team            String   @default("B2C")
  department_id   String?
  department_name String?
  whatsapp_phone  String?
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model AssignmentLog {
  id           String   @id @default(uuid())
  lead_id      String
  agent_id     String
  agent_name   String
  team         String
  assigned_at  DateTime @default(now())
  wa_notified  Boolean  @default(false)

  // Backstop against duplicate assignment rows for the same lead+agent pair.
  // Legitimate reassignment to a *different* agent still gets its own row.
  @@unique([lead_id, agent_id])
}

model CompletedQueue {
  id          String   @id @default(uuid())
  agent_id    String
  agent_name  String
  team        String
  lead_id     String
  queued_at   DateTime @default(now())
}

model WorkflowSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
}

model LateLead {
  id           String    @id @default(uuid())
  lead_id      String    @unique
  created_at   DateTime  @default(now())
  processed    Boolean   @default(false)
  processed_at DateTime?
}

// Last Bitrix ASSIGNED_BY_ID we actually observed for a lead. Lets
// handleLeadChangeWebhook tell "the owner genuinely just changed" apart from
// "the manager's account merely touched an already-correctly-assigned lead",
// which used to be misread as a fresh reassignment on every touch.
model LeadOwner {
  lead_id        String   @id
  assigned_by_id String
  updated_at     DateTime @updatedAt
}

// Leads flagged by the duplicate guardrail. Left unassigned in Bitrix on
// purpose — no agent, no manager, no task, no WhatsApp — for a human to
// review from the Duplicates page instead of being auto-routed anywhere.
model DuplicateLead {
  id               String    @id @default(uuid())
  lead_id          String    @unique
  lead_name        String
  team             String
  matched_lead_ids String    // JSON array of the other lead ID(s) it matched
  matched_fields   String    // JSON array of which fields matched (phone, email, name+recent, ...)
  auto_merged      Boolean   @default(false)
  detected_at      DateTime  @default(now())
  resolved         Boolean   @default(false)
  resolved_at      DateTime?
}
