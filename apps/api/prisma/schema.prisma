generator client {
  provider = "prisma-client-js"
}

// LOCAL DEV: SQLite  |  PRODUCTION: overridden by Dockerfile → schema.prod.prisma
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id              String   @id @default(uuid())
  bitrix_user_id  String   @unique
  name            String
  team            String   @default("B2C")
  department_id   String?
  department_name String?
  whatsapp_phone  String?
  is_active       Boolean  @default(true)
  sort_order      Int      @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model AssignmentLog {
  id           String   @id @default(uuid())
  lead_id      String
  agent_id     String
  agent_name   String
  team         String
  assigned_at  DateTime @default(now())
  wa_notified  Boolean  @default(false)

  // Backstop against duplicate assignment rows for the same lead+agent pair.
  // Legitimate reassignment to a *different* agent still gets its own row.
  @@unique([lead_id, agent_id])
}

model WorkflowSetting {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
}

model LateLead {
  id           String    @id @default(uuid())
  lead_id      String    @unique
  created_at   DateTime  @default(now())
  processed    Boolean   @default(false)
  processed_at DateTime?
}

// Last Bitrix ASSIGNED_BY_ID we actually observed for a lead. Lets
// handleLeadChangeWebhook tell "the owner genuinely just changed" apart from
// "the manager's account merely touched an already-correctly-assigned lead",
// which used to be misread as a fresh reassignment on every touch.
model LeadOwner {
  lead_id        String   @id
  assigned_by_id String
  updated_at     DateTime @updatedAt
}

// Leads flagged by the duplicate guardrail on a weak signal only (name+recency,
// no phone/email match). Left unassigned in Bitrix on purpose — no agent, no
// manager, no WhatsApp — for a human to review from the Duplicates page instead
// of being auto-routed or auto-merged.
model DuplicateLead {
  id               String    @id @default(uuid())
  lead_id          String    @unique
  lead_name        String
  team             String
  matched_lead_ids String    // JSON array of the other lead ID(s) it matched
  matched_fields   String    // JSON array of which fields matched (phone, email, name+recent, ...)
  detected_at      DateTime  @default(now())
  resolved         Boolean   @default(false)
  resolved_at      DateTime?
}

// Audit trail for leads auto-merged on a phone/email match: the newer lead
// (lead_id) was set to Junk in Bitrix and folded into the older surviving
// lead (merged_into_lead_id), with no human review needed.
model MergedLead {
  id                  String   @id @default(uuid())
  lead_id             String   @unique
  lead_name           String
  merged_into_lead_id String
  team                String
  matched_fields      String   // JSON array: phone, email, phone (via contact), ...
  merged_at           DateTime @default(now())
}

// Stage-based SLA tracking that replaces the old Bitrix-task system. One row
// per lead currently moving through the workflow: tracks who holds it, since
// when, and which agents in the team have already had a turn this lap. The
// cron sweep (CronService.sweepRotationTimeouts) reassigns to the next agent
// once SLA_MINUTES of business time elapse with the lead still in the "new"
// stage, and ONCRMLEADUPDATE closes the row the instant the stage changes.
model LeadRotation {
  id                 String   @id @default(uuid())
  lead_id            String   @unique
  team               String
  current_agent_id   String   // Agent.id, or "escalation-manager"
  current_agent_name String
  assigned_at        DateTime @default(now())
  tried_agent_ids    String   // JSON array of Agent.id already given this lead in the current lap
  lap_number         Int      @default(1)
  status             String   @default("active") // active | done | escalated
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
}
